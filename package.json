{
  "name": "pomelo-suite",
  "version": "0.1.0",
  "private": true,
  "description": "Canvas SpanGrid control and related design integrations.",
  "type": "commonjs",
  "workspaces": [
    "packages/spangrid",
    "packages/calculator",
    "packages/scheduler",
    "packages/workqueue",
    "packages/runtime",
    "packages/color-picker",
    "packages/input",
    "packages/timeline",
    "packages/diagram",
    "figma-plugins/grideditor"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js && npm run test --workspaces --if-present",
    "lint:syntax": "node scripts/check-js-syntax.cjs",
    "check": "npm run lint:syntax && npm test",
    "pack:dry-run": "npm pack --workspace @pomelo-suite/spangrid --workspace @pomelo-suite/calculator --workspace @pomelo-suite/scheduler --workspace @pomelo-suite/workqueue --workspace @pomelo-suite/runtime --workspace @pomelo-suite/color-picker --workspace @pomelo-suite/input --workspace @pomelo-suite/timeline --workspace @pomelo-suite/diagram --dry-run",
    "package-studio": "node examples/package-studio/server.js",
    "runtime-playground": "node examples/runtime/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xamongmini/pomelo-suite.git"
  },
  "keywords": [
    "pomelo-suite",
    "canvas",
    "grid",
    "data-grid",
    "spangrid",
    "scheduler",
    "workqueue",
    "runtime"
  ],
  "author": "xamongmini",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xamongmini/pomelo-suite/issues"
  },
  "homepage": "https://github.com/xamongmini/pomelo-suite#readme"
}
